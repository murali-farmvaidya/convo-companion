{
  "name": "bhuvi-chatbot-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node start-all.js",
    "start:express": "node ./server.js",
    "dev": "node --watch ./server.js",
    "dev:all": "node start-all.js",
