<graph edgedefault="undirected"><node id="Farm Vaidya">
  <data key="d0">Farm Vaidya</data>
  <data key="d1">organization</data>
  <data key="d2">Farm Vaidya is an organization developing agricultural solutions powered by Gen AI technology, focused on improving access for smallholder farmers in India.&lt;SEP&gt;Farm Vaidya is an organization that provides Generative AI-powered conversational solutions aimed at improving agriculture.&lt;SEP&gt;Farm Vaidya is an organization founded to utilize Generative AI-driven voice technology for providing agricultural knowledge to farmers.</data>
  <data key="d3">chunk-41a8512cee29cb09c7d8da7cb7471f19&lt;SEP&gt;chunk-f471ff49dc2c427541bf8c97ee81b566&lt;SEP&gt;chunk-1a4414bee950e69a7240a65f65711f77</data>
  <data key="d4">fvd.pdf</data>
  <data key="d5">1767611954</data>
  <data key="d6"></data>
</node>
<node id="Gen AI">
  <data key="d0">Gen AI</data>
  <data key="d1">concept</data>
  <data key="d2">Gen AI refers to advanced artificial intelligence technologies that revolutionize agricultural intelligence by providing innovative solutions.</data>
  <data key="d3">chunk-41a8512cee29cb09c7d8da7cb7471f19</data>
  <data key="d4">fvd.pdf</data>
  <data key="d5">1767611954</data>
  <data key="d6"></data>
</node>
<node id="Voice Agent">
  <data key="d0">Voice Agent</data>
  <data key="d1">method</data>
  <data key="d2">The Voice Agent is an AI-powered conversational tool that enables agricultural organizations to provide support in regional languages.&lt;SEP&gt;The Voice Agent is a type of conversational AI developed by Farm Vaidya to provide personalized agricultural solutions.</data>
  <data key="d3">chunk-41a8512cee29cb09c7d8da7cb7471f19&lt;SEP&gt;chunk-f471ff49dc2c427541bf8c97ee81b566</data>
  <data key="d4">fvd.pdf</data>
  <data key="d5">1767611954</data>
  <data key="d6"></data>
</node>
<node id="Rythuvaani">
  <data key="d0">Rythuvaani</data>
  <data key="d1">project</data>
  <data key="d2">Rythuvaani is a project focused on creating a Telugu agriculture domain-specific dataset for building a Speech-to-Text (STT) system.&lt;SEP&gt;Rythuvaani is a project under Farm Vaidya focusing on agricultural voice solutions.</data>
  <data key="d3">chunk-41a8512cee29cb09c7d8da7cb7471f19&lt;SEP&gt;chunk-f471ff49dc2c427541bf8c97ee81b566</data>
  <data key="d4">fvd.pdf</data>
  <data key="d5">1767611955</data>
  <data key="d6"></data>
</node>
<node id="Automatic Speech Recognition (ASR)">
  <data key="d0">Automatic Speech Recognition (ASR)</data>
  <data key="d1">concept</data>
  <data key="d2">Automatic Speech Recognition (ASR) refers to technology for converting spoken language into text, specifically tailored for agricultural terminology in India.</data>
  <data key="d3">chunk-41a8512cee29cb09c7d8da7cb7471f19</data>
  <data key="d4">fvd.pdf</data>
  <data key="d5">1767611955</data>
  <data key="d6"></data>
</node>
<node id="Telugu">
  <data key="d0">Telugu</data>
  <data key="d1">language</data>
  <data key="d2">Telugu is one of the regional languages employed in Farm Vaidya’s solutions, particularly in developing voice agents and datasets.</data>
  <data key="d3">chunk-41a8512cee29cb09c7d8da7cb7471f19</data>
  <data key="d4">fvd.pdf</data>
  <data key="d5">1767611955</data>
  <data key="d6"></data>
</node>
<node id="30,000 Hours">
  <data key="d0">30,000 Hours</data>
  <data key="d1">data</data>
  <data key="d2">30,000 hours of conversational agricultural audio is being collected for the development of an advanced STT system that captures diverse dialects.</data>
  <data key="d3">chunk-41a8512cee29cb09c7d8da7cb7471f19</data>
  <data key="d4">fvd.pdf</data>
  <data key="d5">1767611955</data>
