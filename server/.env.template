# ========================================
# BHUVI CHATBOT - CONFIGURATION TEMPLATE
# ========================================
# Copy this file to .env and fill in your values
# This is the ONLY .env file you need to edit!

# ========================================
# EXPRESS SERVER CONFIGURATION
# ========================================
PORT=3000
MONGODB_URI=your_mongodb_connection_string_here

# ========================================
# LIGHTRAG SERVER CONFIGURATION
# ========================================
LIGHTRAG_HOST=0.0.0.0
LIGHTRAG_PORT=9621
LIGHTRAG_API_URL=http://localhost:9621

# LightRAG UI Configuration
WEBUI_TITLE=Bhuvi Chatbot RAG
WEBUI_DESCRIPTION=Bhuvi Agricultural Knowledge Base

# CORS - Allow these origins to access the API
# For production, add your frontend domain
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ========================================
# AI/LLM CONFIGURATION (REQUIRED)
# ========================================
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ========================================
# OPTIONAL: Alternative LLM Providers
# ========================================
# Anthropic Claude
# ANTHROPIC_API_KEY=

# Google Gemini
# GEMINI_API_KEY=

# Local Ollama (if running models locally)
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMULATING_MODEL_TAG=latest

# ========================================
# OPTIONAL: Advanced Configuration
# ========================================
# Request timeouts (in seconds)
# TIMEOUT=150
# LLM_TIMEOUT=120
# EMBEDDING_TIMEOUT=120

# Custom directories
# INPUT_DIR=./inputs
# WORKING_DIR=./rag_storage
